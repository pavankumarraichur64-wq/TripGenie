# Copy this file to backend/.env and replace the placeholders for your setup.
# Never commit .env files or real credentials.

# Database: use a MySQL account created for this project, or choose SQLite:
# sqlite:///./tripgenie.db
DATABASE_URL=mysql+pymysql://tripgenie_user:change-me@localhost/tripgenie

# Generate a unique key for your environment.
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave empty to use the built-in fallback itinerary and chat responses.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Frontend and AI rate limiting
FRONTEND_ORIGIN=http://localhost:5173
AI_RATE_LIMIT=10/minute

# Set False to skip Wikipedia scraping when seeding.
SCRAPE_ON_SEED=True
